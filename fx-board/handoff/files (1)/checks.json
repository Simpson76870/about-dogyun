{
  "version": 1,
  "feature": "환율 정보판: 마지막 갱신 시각 표시 + 오래된 데이터 경고",
  "common_limits": { "time_minutes_per_ai": 90, "requests_per_ai": 25 },
  "stale_threshold_hours": 36,
  "checks": [
    {
      "id": "T-01", "owner": "A",
      "title": "신선한 데이터: 갱신 시각이 KST로 보이고 경고는 숨김",
      "input": { "updated_at": "2026-10-20T00:10:00Z", "now": "2026-10-20T06:10:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "fresh" },
        { "type": "text", "selector": "#last-updated", "contains": "2026-10-20 09:10" },
        { "type": "hidden", "selector": "#stale-banner" }
      ]
    },
    {
      "id": "T-02", "owner": "A",
      "title": "경과 시간이 '6시간 전'으로 보임",
      "input": { "updated_at": "2026-10-20T00:10:00Z", "now": "2026-10-20T06:10:00Z" },
      "expect": [
        { "type": "text", "selector": "#last-updated", "contains": "6시간 전" }
      ]
    },
    {
      "id": "T-03", "owner": "A",
      "title": "경계값: 정확히 36시간 경과는 아직 신선",
      "input": { "updated_at": "2026-10-20T00:10:00Z", "now": "2026-10-21T12:10:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "fresh" },
        { "type": "hidden", "selector": "#stale-banner" }
      ]
    },
    {
      "id": "T-04", "owner": "A",
      "title": "경계값: 36시간 1분 경과는 오래됨, 경고 표시",
      "input": { "updated_at": "2026-10-20T00:10:00Z", "now": "2026-10-21T12:11:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "stale" },
        { "type": "visible", "selector": "#stale-banner" },
        { "type": "text", "selector": "#stale-banner", "contains": "오래된 데이터" }
      ]
    },
    {
      "id": "T-05", "owner": "A",
      "title": "5일 경과: '5일 전'과 갱신 시각이 함께 보이고 경고 표시",
      "input": { "updated_at": "2026-10-15T00:10:00Z", "now": "2026-10-20T00:10:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "stale" },
        { "type": "text", "selector": "#last-updated", "contains": "5일 전" },
        { "type": "text", "selector": "#last-updated", "contains": "2026-10-15 09:10" },
        { "type": "visible", "selector": "#stale-banner" }
      ]
    },
    {
      "id": "T-06", "owner": "B",
      "title": "updated_at 항목이 없음: unknown, 안내 경고, 마지막 값은 그대로 표시",
      "input": { "updated_at": null, "now": "2026-10-20T06:10:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "unknown" },
        { "type": "text", "selector": "#stale-banner", "contains": "갱신 시각을 알 수 없습니다" },
        { "type": "visible", "selector": "[data-rate]" }
      ]
    },
    {
      "id": "T-07", "owner": "B",
      "title": "updated_at이 날짜가 아닌 글자('어제'): unknown과 같은 안내",
      "input": { "updated_at": "어제", "now": "2026-10-20T06:10:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "unknown" },
        { "type": "text", "selector": "#stale-banner", "contains": "갱신 시각을 알 수 없습니다" }
      ]
    },
    {
      "id": "T-08", "owner": "B",
      "title": "updated_at이 현재보다 미래(10분 뒤): fresh로 속이지 않고 unknown",
      "input": { "updated_at": "2026-10-20T00:10:00Z", "now": "2026-10-20T00:00:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "unknown" },
        { "type": "text", "selector": "#stale-banner", "contains": "갱신 시각을 알 수 없습니다" }
      ]
    },
    {
      "id": "T-09", "owner": "B",
      "title": "data/history.json 요청이 404: unknown, 경고 표시, 화면 오류 없음",
      "input": { "http_status": 404, "now": "2026-10-20T06:10:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "unknown" },
        { "type": "visible", "selector": "#stale-banner" },
        { "type": "no-pageerror" }
      ]
    },
    {
      "id": "T-10", "owner": "B",
      "title": "오래된 상태에서도 마지막 정상 환율 값이 신선할 때와 똑같이 남아 있음",
      "input": { "updated_at": "2026-10-15T00:10:00Z", "now": "2026-10-20T00:10:00Z" },
      "expect": [
        { "type": "attr", "selector": "#freshness", "name": "data-state", "equals": "stale" },
        { "type": "rates-equal", "ref": "T-01", "selector": "[data-rate]" }
      ]
    }
  ]
}
